        .news {
            position: relative;
            text-align: left;
            width: 415px;
            height: 191px;
            margin: 30px auto 0 auto;
            background: url(templates/wowhead/images/mainpage-bg-news-enus.jpg) no-repeat
        }

        .news-list {
            padding: 26px 0 0 26px;
            margin: 0
        }

        .news-list li {
            line-height: 2em
        }

        .news-img1 {
            position: absolute;
            left: 60px;
            top: 155px;
            width: 172px;
            height: 17px
        }

        .news-img2 {
            position: absolute;
            left: 246px;
            top: 48px;
            width: 145px;
            height: 127px
        }

        .news-talent {
            position: absolute;
            left: 240px;
            top: 29px;
            width: 152px;
            height: 146px
        }

        .mp-comments {
            position: relative;
            text-align: left;
            width: 415px;
            margin: 26px auto 0 auto;
            padding: 10px 14px 12px;
            box-sizing: border-box;
            background: rgba(0, 0, 0, .35);
            border: 1px solid #3a3a3a;
            border-radius: 4px
        }

        .mp-comments-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 6px;
            margin-bottom: 6px;
            border-bottom: 1px solid #3a3a3a
        }

        .mp-comments-title {
            color: #ffd100;
            font-weight: bold
        }

        .mp-comments-tabs {
            font-size: 11px
        }

        .mp-tab {
            margin-left: 10px;
            color: #7d7d7d;
            text-decoration: none
        }

        .mp-tab:hover {
            color: #fff
        }

        .mp-tab-active {
            color: #fff;
            text-decoration: underline
        }

        .mp-comments-list {
            margin: 0;
            padding: 0;
            list-style: none
        }

        .mp-comments-list li {
            display: flex;
            align-items: baseline;
            line-height: 1.75em
        }

        .mp-comments-list li a {
            flex: 1 1 auto;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis
        }

        .mp-type {
            flex: 0 0 auto;
            margin: 0 8px;
            color: #7d7d7d;
            font-size: 10px;
            text-transform: uppercase
        }

        .mp-count {
            flex: 0 0 auto;
            min-width: 2.2em;
            color: #ffd100;
            font-size: 11px;
            text-align: right
        }

        .mp-empty {
            color: #7d7d7d
        }

        
    </style>
</head>
