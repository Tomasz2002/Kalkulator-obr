        <script type="text/javascript">
            
            function mpShowComments(which) {
                var most = document.getElementById('mp-list-most'),
                    neu = document.getElementById('mp-list-new'),
                    tMost = document.getElementById('mp-tab-most'),
                    tNew = document.getElementById('mp-tab-new');
                if (!most || !neu) return;
                if (which === 'new') {
                    most.style.display = 'none';
                    neu.style.display = '';
                    tNew.className = 'mp-tab mp-tab-active';
                    tMost.className = 'mp-tab';
                } else {
                    neu.style.display = 'none';
                    most.style.display = '';
                    tMost.className = 'mp-tab mp-tab-active';
                    tNew.className = 'mp-tab';
                }
            }
            
        </script>
    
